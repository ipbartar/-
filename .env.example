# ============================================
# 🤖 متغیرهای ربات تلگرام (الزامی)
# ============================================

# توکن ربات (دریافت از BotFather)
BOT_TOKEN=123456789:ABCDEFGHIJKLmnopqrstuvwxyzABCDEF

# نام کاربری ربات (بدون @)
BOT_USERNAME=your_bot_username

# شناسه ادمین (فقط ارقام)
ADMIN_ID=123456789

# ============================================
# 🗄️ متغیرهای دیتابیس
# ============================================

# نام دیتابیس
DB_NAME=mirzaprobot

# کاربر دیتابیس
DB_USER=root

# رمز عبور دیتابیس (قوی نگه دارید!)
DB_PASSWORD=mirzapro_secure_2024_change_me

# نام هوسト دیتابیس (برای Railway: localhost)
DB_HOST=localhost

# پورت دیتابیس
DB_PORT=3306

# ============================================
# 🌐 متغیرهای دامنه و Webhook
# ============================================

# 🔴 اهم: Railway این را خودکار تنظیم می‌کند!
# شما نیاز نیست این را تغییر دهید
RAILWAY_PUBLIC_DOMAIN=auto

# دامنه اصلی (خودکار تشخیص داده می‌شود)
# اگر خالی بگذارید: خودکار از RAILWAY_PUBLIC_DOMAIN استفاده می‌کند
BOT_DOMAIN=

# آدرس کامل Webhook (خودکار ساخته می‌شود)
# اگر خالی بگذارید: خودکار از دامنه عمومی استفاده می‌کند
# مثال ساخت خودکار: https://your-bot-name.railway.app/webhook
WEBHOOK_URL=

# کلید محرمانه Webhook (برای امنیت)
WEBHOOK_SECRET=your_very_secure_secret_key_here_12345

# ============================================
# 📊 متغیرهای پنل VPN
# ============================================

# نوع پنل (marzban, marzneshin, sanaei, alireza, s-ui, hiddify)
PANEL_TYPE=marzban

# آدرس URL پنل
# مثال: https://vpn-panel.example.com
PANEL_URL=https://your-panel-url.com

# نام کاربری ادمین پنل
PANEL_USERNAME=admin_username

# رمز عبور پنل
PANEL_PASSWORD=panel_password_here

# API Key پنل (در صورت نیاز)
PANEL_API_KEY=your_api_key_if_needed

# ============================================
# 💳 متغیرهای درگاه پرداخت
# ============================================

# درگاه پرداخت (zarinpal, perfect_money, coinbase, ethereum)
PAYMENT_GATEWAY=zarinpal

# Zarinpal
ZARINPAL_MERCHANT=your_zarinpal_merchant_id
ZARINPAL_API_KEY=your_zarinpal_api_key

# Perfect Money
PERFECT_MONEY_ACCOUNT=your_perfect_money_account
PERFECT_MONEY_PASSWORD=your_perfect_money_password

# Coinbase
COINBASE_API_KEY=your_coinbase_api_key

# ============================================
# 💰 متغیرهای قیمت‌گذاری
# ============================================

# حداقل قیمت (به تومان)
MIN_PRICE=1000

# حداکثر قیمت (به تومان)
MAX_PRICE=1000000

# درصد سود
PROFIT_PERCENTAGE=10

# ============================================
# ⚙️ متغیرهای پیشرفته
# ============================================

# حالت Debug (true/false)
DEBUG_MODE=false

# سطح لاگ (ERROR, WARNING, INFO, DEBUG)
LOG_LEVEL=INFO

# منطقه زمانی
TZ=Asia/Tehran

# حداکثر کننده‌های همزمان
MAX_CONCURRENT_USERS=100

# تایم‌اوت (برای درخواست‌های API)
API_TIMEOUT=30

# ============================================
# 🔐 متغیرهای امنیتی
# ============================================

# کلید رمزنگاری
ENCRYPTION_KEY=your_encryption_key_here

# نمک (Salt)
PASSWORD_SALT=your_salt_here

# ============================================
# 📧 متغیرهای ایمیل (اختیاری)
# ============================================

# سرور SMTP
SMTP_HOST=smtp.gmail.com

# پورت SMTP
SMTP_PORT=587

# ایمیل
SMTP_EMAIL=your-email@gmail.com

# رمز ایمیل
SMTP_PASSWORD=your_app_password

# ============================================
# 📱 متغیرهای پیام‌رسان اضافی (اختیاری)
# ============================================

# برای اطلاع‌رسانی‌های تکمیلی
NOTIFICATION_CHAT_ID=123456789

# ============================================
# 🚀 متغیرهای Railway
# ============================================

# فعال کردن SSL
ENABLE_SSL=true

# حداقل تعداد Worker
MIN_INSTANCES=1

# حداکثر تعداد Worker (برای Auto-scaling)
MAX_INSTANCES=5
